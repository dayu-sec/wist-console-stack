# 手工 `docker compose` 使用的默认值；`gops sys localize` 会生成同名 .env。
# 现场覆盖值写 ops-prj 的 values/，不要改 sys/setting/vars.yml。

CONSOLE_REGISTRY=ghcr.io/dayu-sec
CONSOLE_IMAGE_TAG=v0.1.9-alpha
CONSOLE_WEB_IMAGE_TAG=v0.1.9-alpha
EVIDENCE_IMAGE_TAG=v0.1.12-alpha

ATLAS_REGISTRY=ghcr.io/dayu-sec
ATLAS_IMAGE_TAG=v0.3.1
ATLAS_WEB_IMAGE_TAG=v0.1.1-alpha

PG_REGISTRY=docker.io/library
PG_IMAGE_TAG=16

# 浏览器入口（前面应该有 VPN / 堡垒机，并注入 x-console-operator）
WEB_BIND_IP=127.0.0.1
WEB_HOST_PORT=8088

# 证据写端口：数据面 http_sink 的投递目标（现场改成内网地址）
EVIDENCE_SINK_BIND_IP=127.0.0.1
EVIDENCE_SINK_HOST_PORT=18800

# 证据读端口（容器内；evidence 配置 / 健康检查 / console base_url 共用这一个值）
EVIDENCE_READ_PORT=8443

# 资产拓扑写端口：数据面 wparse 投 DSNAP（现场改成内网地址）
ATLAS_INGEST_BIND_IP=127.0.0.1
ATLAS_INGEST_HOST_PORT=18801
# 写探针：往保留租户写一份最小 DSNAP，验「转换 → 落库 → 物化」
ATLAS_PROBE=on
ATLAS_PROBE_INTERVAL_SECS=300

# 运行指标（VictoriaMetrics）：数据面 remote write 进来，运维从这里查
VM_REGISTRY=quay.io/victoriametrics
VM_IMAGE_TAG=v1.154.0
VM_BIND_IP=127.0.0.1
VM_HOST_PORT=18428
VM_RETENTION=30d

PG_BIND_IP=127.0.0.1
EVIDENCE_PG_HOST_PORT=55434
ATLAS_PG_HOST_PORT=55435

EVIDENCE_PG_DB=wist_evidence
EVIDENCE_PG_USER=evidence
EVIDENCE_PG_PASSWORD=evidence-dev-only

ATLAS_PG_DB=wist_atlas
ATLAS_PG_USER=atlas
ATLAS_PG_PASSWORD=atlas-dev-only

TZ=Asia/Shanghai
